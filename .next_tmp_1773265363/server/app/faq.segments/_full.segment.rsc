e:["$","$1","c",{"children":[["$","div",null,{"className":"section-shell space-y-9 py-7 md:py-10","children":[["$","section",null,{"className":"rounded-3xl border border-fawaid-border bg-white px-5 py-7 shadow-soft md:px-8 md:py-8","children":["$","div",null,{"className":"max-w-3xl space-y-3","children":[["$","h1",null,{"className":"font-heading text-2xl font-semibold leading-tight md:text-4xl","children":"FAQ"}],["$","p",null,{"className":"text-sm text-fawaid-muted md:text-base","children":"Retrouvez les réponses essentielles pour choisir votre programme, votre formule et démarrer dans un cadre clair."}],null]}]}],["$","section",null,{"children":["$","$L11",null,{"items":[{"question":"Les cours sont-ils en direct ?","answer":"Oui. Les cours sont dispensés en direct, en visio, afin de permettre un véritable échange avec le professeur et un accompagnement plus vivant."},{"question":"À qui s’adressent les cours ?","answer":"Les cours s’adressent à des élèves de différents niveaux, du débutant à l’élève déjà avancé, selon les programmes proposés."},{"question":"Quels formats proposez-vous ?","answer":"L’Institut Fawaid propose des cours en solo, en duo et en groupe, afin de s’adapter aux besoins et au rythme de chacun."},{"question":"Quel programme choisir si je débute ?","answer":"Si vous débutez totalement, des programmes d’entrée en lecture comme Al-Baghdadiya ou Nour Al-Bayan peuvent constituer une base pertinente selon votre profil. L’institut peut vous orienter vers le programme le plus adapté."},{"question":"Proposez-vous des cours pour apprendre à lire le Coran ?","answer":"Oui. L’institut propose des cours destinés à améliorer la lecture, le Tajwid, la mémorisation et la correction de la récitation."},{"question":"Les cours sont-ils adaptés aux enfants ?","answer":"Certains supports, notamment Nour Al-Bayan, se prêtent particulièrement bien à un apprentissage encadré pour les plus jeunes."},{"question":"Comment s’inscrire ?","answer":"Vous pouvez utiliser le bouton d’inscription ou contacter directement l’institut pour être orienté vers le format le plus adapté."},{"question":"Puis-je être conseillé avant de choisir une formule ?","answer":"Oui. L’objectif est de vous orienter selon votre niveau, vos objectifs et vos disponibilités."},{"question":"Les cours sont-ils réservés à un objectif religieux ?","answer":"Non. L’apprentissage peut répondre à des objectifs personnels, culturels, linguistiques ou religieux."},{"question":"Comment vous contacter rapidement ?","answer":"Le moyen le plus direct est de passer par WhatsApp ou par le formulaire de contact."},{"question":"Quels moyens de paiement acceptez-vous ?","answer":"Les paiements peuvent être effectués par PayPal, Wero ou virement bancaire."},{"question":"Y a-t-il un cours d’essai ?","answer":"Non. L’institut ne propose pas de cours d’essai."},{"question":"Que se passe-t-il en cas d’absence ?","answer":"Toute absence doit être signalée au minimum 24h à l’avance. À défaut, le cours est décompté de la formule."}]}]}],["$","section",null,{"className":"rounded-3xl border border-fawaid-border bg-[linear-gradient(180deg,rgba(245,241,232,0.65),rgba(255,255,255,1))] p-6 shadow-soft md:p-7","children":[["$","div",null,{"className":"space-y-3","children":[null,["$","h2",null,{"className":"font-heading text-2xl font-semibold leading-tight text-fawaid-text md:text-3xl","children":"Une question plus spécifique ?"}],["$","p",null,{"className":"max-w-3xl text-fawaid-muted","children":"Nous vous orientons rapidement selon votre niveau, vos objectifs et vos disponibilités."}]]}],["$","div",null,{"className":"mt-5 flex flex-wrap gap-2.5","children":["$L12","$L13"]}]]}]]}],["$L14"],"$L15"]}]
